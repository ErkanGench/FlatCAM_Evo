#: appDatabase.py:521 appPlugins/ToolMilling.py:4309
msgid ""
"- Isolation -> informative - lower Feedrate as it uses a milling bit with a "
"fine tip.\n"
"- Roughing  -> informative - lower Feedrate and multiDepth cut.\n"
"- Finishing -> informative - higher Feedrate, without multiDepth.\n"
"- Polish -> adds a painting sequence over the whole area of the object"
msgstr ""
"- Aislamiento -> informativo - avance menor, ya que utiliza una fresa de "
"punta fina.\n"
"- Desbaste -> informativo - avance menor y corte en varias profundidades.\n"
"- Acabado -> informativo - avance mayor, sin multiprofundidad.\n"
"- Pulido -> añade una secuencia de pintura sobre toda el área del objeto"

#: appDatabase.py:537
msgid "Tool Offset"
msgstr "Offset de Herram"

# auto-review 2026-10-09: corrected
#: appDatabase.py:539
msgid ""
"Tool Offset.\n"
"Can be of a few types:\n"
"Path = zero offset\n"
"In = offset inside by half of tool diameter\n"
"Out = offset outside by half of tool diameter\n"
"Custom = custom offset using the Custom Offset value"
msgstr ""
"Desplazamiento de herramienta.\n"
"Puede ser de varios tipos:\n"
"Ruta = desplazamiento cero\n"
"Dentro = desplazamiento hacia el interior igual a la mitad del diámetro de "
"la herramienta\n"
"Fuera = desplazamiento hacia el exterior igual a la mitad del diámetro de "
"la herramienta\n"
"Personalizado = desplazamiento personalizado con el valor de Desplazamiento "
"personalizado"

