#: appDatabase.py:521 appPlugins/ToolMilling.py:4309
msgid ""
"- Isolation -> informative - lower Feedrate as it uses a milling bit with a "
"fine tip.\n"
"- Roughing  -> informative - lower Feedrate and multiDepth cut.\n"
"- Finishing -> informative - higher Feedrate, without multiDepth.\n"
"- Polish -> adds a painting sequence over the whole area of the object"
msgstr ""
"- Isolamento -> informativa - avanzamento più basso perché usa una fresa a "
"punta fine.\n"
"- Sgrezzatura  -> informativa - avanzamento più basso e taglio multi "
"profondità.\n"
"- Rifinitura -> informativa - avanzamento più alto, senza multi "
"profondità.\n"
"- Lucidatura -> aggiunge una sequenza di disegno (Paint) su tutta l'area "
"dell'oggetto"

#: appDatabase.py:537
msgid "Tool Offset"
msgstr "Offset utensile"

# auto-review 2026-10-09: corrected
#: appDatabase.py:539
msgid ""
"Tool Offset.\n"
"Can be of a few types:\n"
"Path = zero offset\n"
"In = offset inside by half of tool diameter\n"
"Out = offset outside by half of tool diameter\n"
"Custom = custom offset using the Custom Offset value"
msgstr ""
"Offset utensile.\n"
"Può essere di vari tipi:\n"
"Percorso = nessun offset\n"
"Dentro = offset verso l'interno di metà diametro dell'utensile\n"
"Fuori = offset verso l'esterno di metà diametro dell'utensile\n"
